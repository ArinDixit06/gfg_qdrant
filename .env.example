# ---- Device identity ----
DEVICE_ID=edge-device-01
DEVICE_NAME=Edge Device 01

# ---- Local edge agent ----
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8000
SHARD_ROOT=./data
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_NAME=content
VECTOR_DIM=384

# ---- Cloud Qdrant Server ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=edge-collection
# Server-side shard id this device syncs against (per-device sharding).
SERVER_SHARD_ID=0

# ---- Sync behavior ----
CONNECTIVITY_POLL_SECONDS=5
PUSH_INTERVAL_SECONDS=10
PULL_INTERVAL_SECONDS=20
# Force offline for the demo without touching real networking.
FORCE_OFFLINE=false

# ---- Metadata Postgres ----
DATABASE_URL=postgresql://edge:edgepass@localhost:5432/edgememory
# Set to false to run the agent without Postgres (metadata logging becomes a no-op).
POSTGRES_ENABLED=true
